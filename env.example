# Supabase (required for auth, RBAC, invite flow)
# Project Settings > API in Supabase Dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical public URL for auth redirects (invite → /auth/callback). Must match Dashboard redirect allowlist exactly.
# Local dev (this repo uses port 3005):
# NEXT_PUBLIC_SITE_URL=http://localhost:3005
# Production (example):
# NEXT_PUBLIC_SITE_URL=https://online.genericmusic.net
# Server-only (invite/admin APIs). Never expose to the browser or NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: same as NEXT_PUBLIC_SUPABASE_URL if you prefer a server-only duplicate (API routes accept either)
# SUPABASE_URL=
# For invite flow: Auth > URL Configuration > Redirect URLs (add all that you use):
#   http://localhost:3005/auth/callback
#   https://online.genericmusic.net/auth/callback
#   (optional) /auth/set-password paths if used
# Auth > Email: custom SMTP recommended for production (see docs/supabase-production-email-gmw.md)

# GMW Pulse: set to "false" to disable single-admin mode (show owner/team)
# NEXT_PUBLIC_SINGLE_ADMIN_MODE=false

# RBAC bypass: set to "true" to temporarily disable route/action checks (dev recovery only)
# NEXT_PUBLIC_DISABLE_RBAC=true

# Dev-only seed (NEVER set SEED_USERS=true in production)
SEED_USERS=false
SEED_PASSWORD_SYSTEM_OWNER=123456
SEED_PASSWORD_CEO=123456
