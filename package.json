{
  "name": "generic-music-world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005 -H 127.0.0.1 --webpack",
    "dev:free-port": "bash scripts/dev-free-port.sh",
    "dev:clean": "rm -rf .next && next dev -p 3005 -H 127.0.0.1 --webpack",
    "dev:fresh": "bash scripts/dev-free-port.sh 3005 && rm -rf .next && next dev -p 3005 -H 127.0.0.1 --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:onboarding-gate": "npx tsx scripts/verify-onboarding-gate-logic.ts",
    "seed:users": "npx tsx scripts/seed-users.ts",
    "seed:notifications": "npx tsx scripts/seed-notifications.ts",
    "db:push": "npx tsx scripts/db-push-rbac.ts",
    "db:gen-types": "npx supabase gen types typescript --linked --schema public > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.95.3",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "pg": "^8.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.7.0",
    "typescript": "^5"
  }
}
